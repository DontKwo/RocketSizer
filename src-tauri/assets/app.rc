1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x00040004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "RocketSizer"
      VALUE "FileDescription", "RocketSizer launch vehicle conceptual design workstation"
      VALUE "InternalName", "RocketSizer"
      VALUE "OriginalFilename", "RocketSizer.exe"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
